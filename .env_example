# ════════════════════════════════════════════════════════════════════════════════
# RAG PIPELINE CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════

# SEMANTIC SCHOLAR API
# - Optional: Required only for `ingest-api` command to fetch papers from API
# - Get free API key from: https://www.semanticscholar.org/product/api
# - Without this: ingest-api will have lower rate limits (100 requests/day)
SEMANTIC_SCHOLAR_API_KEY=your-api-key-here

# ════════════════════════════════════════════════════════════════════════════════
# LLM CONFIGURATION (Ollama/Qwen)
# ════════════════════════════════════════════════════════════════════════════════

# OLLAMA MODEL
# - Model to use for claim analysis and evidence aggregation
# - Default: frob/qwen3.5-instruct:9b
# - Pull the model first: ollama pull frob/qwen3.5-instruct:9b
OLLAMA_MODEL=frob/qwen3.5-instruct:9b

# OLLAMA BASE URL
# - URL where Ollama server is running
# - Default: http://localhost:11434
# - Start Ollama server: ollama serve
OLLAMA_BASE_URL=http://localhost:11434

# OLLAMA TIMEOUT
# - Request timeout in seconds
# - Default: 120
# - Increase if running large models or slow hardware
OLLAMA_TIMEOUT=120

# ════════════════════════════════════════════════════════════════════════════════
# EMBEDDING CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════

# EMBEDDING MODEL
# - Hugging Face model identifier for sentence embeddings
# - Default: all-MiniLM-L6-v2 (384 dimensions, fast & accurate)
# - Other options:
#   - all-mpnet-base-v2 (768D, more accurate but slower)
#   - distiluse-base-multilingual-cased-v2 (512D, multilingual)
#   - all-roberta-large-v1 (1024D, highest quality)
EMBEDDING_MODEL=all-MiniLM-L6-v2
